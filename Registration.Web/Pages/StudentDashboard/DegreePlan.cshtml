@page
@model Registration.Web.Pages.StudentDashboard.DegreePlanModel
@{
    ViewData["Title"] = "Degree Plan";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-4 px-md-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2">
        <div>
            <h2 class="display-6 fw-bolder text-dark mb-1" style="letter-spacing: -1px;">Degree Plan Roadmap</h2>
            <p class="text-muted fs-5 mb-0">Curriculum progress for <span class="fw-bold text-info">@Model.StudentProfile.StudentName</span></p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-page="./Index" asp-route-studentId="@Model.StudentProfile.Id" class="btn btn-light border shadow-sm rounded-pill px-4 py-2 fw-semibold hover-lift">
                <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-4 border-0 border-start border-5 border-danger mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Progress Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-xl-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="fw-bold text-dark mb-3">Overall Degree Progress</h5>
                    <div class="progress rounded-pill bg-light mb-2 shadow-inner" style="height: 16px;">
                        @{
                            double progressPercentage = 0;
                            if (Model.TotalRequiredCredits > 0)
                            {
                                progressPercentage = Math.Min(100, Math.Round((double)Model.TotalEarnedCredits / Model.TotalRequiredCredits * 100, 1));
                            }
                        }
                        <div class="progress-bar bg-info progress-bar-striped progress-bar-animated rounded-pill" role="progressbar" style="width: @progressPercentage%;" aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between text-muted fw-medium small">
                        <span>@progressPercentage% Completed</span>
                        <span>Bachelor's Track</span>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-4 mt-md-0">
                    <div class="d-inline-block bg-info bg-opacity-10 rounded-4 p-3 border border-info border-opacity-25 text-center">
                        <span class="d-block text-uppercase text-info fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">Credits Earned</span>
                        <h2 class="text-info fw-bolder mb-0">@Model.TotalEarnedCredits <span class="fs-5 text-muted fw-normal">/ @Model.TotalRequiredCredits</span></h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Course List Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-bottom p-4">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-map me-2 text-info"></i> Full Curriculum Requirements</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light bg-opacity-50 text-muted" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="px-4 py-3 fw-semibold border-0 text-uppercase">Course</th>
                            <th class="py-3 fw-semibold border-0 text-uppercase text-center">Credits</th>
                            <th class="py-3 fw-semibold border-0 text-uppercase text-center">Final Grade</th>
                            <th class="px-4 py-3 fw-semibold border-0 text-uppercase text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DegreeCourses.Any())
                        {
                            foreach (var course in Model.DegreeCourses)
                            {
                                string statusLower = course.Status.ToLower();
                                string badgeClass = "bg-secondary text-secondary";
                                string icon = "bi-circle";
                                string rowClass = ""; // 🌟 Added to dim "Not Taken" rows

                                if (statusLower == "completed")
                                {
                                    badgeClass = "bg-success text-success";
                                    icon = "bi-check-circle-fill";
                                }
                                else if (statusLower == "enrolled" || statusLower == "active")
                                {
                                    badgeClass = "bg-primary text-primary";
                                    icon = "bi-arrow-repeat";
                                }
                                else if (statusLower == "dropped" || statusLower == "failed")
                                {
                                    badgeClass = "bg-danger text-danger";
                                    icon = "bi-x-circle-fill";
                                }
                                else if (statusLower == "not taken")
                                {
                                    rowClass = "opacity-75 bg-light bg-opacity-25"; // 🌟 Dims unattempted courses slightly
                                }

                                <tr class="@rowClass">
                                    <td class="px-4 py-3 border-light">
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark fs-6">@course.CourseName</span>
                                            <span class="text-muted small fw-medium">@course.CourseCode</span>
                                        </div>
                                    </td>
                                    <td class="py-3 border-light text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1 shadow-sm">@course.CreditHours</span>
                                    </td>
                                    <td class="py-3 border-light text-center fw-bold text-dark fs-5">
                                        @course.LetterGrade
                                    </td>
                                    <td class="px-4 py-3 border-light text-end">
                                        <span class="badge @badgeClass bg-opacity-10 border border-opacity-25 px-3 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                                            <i class="bi @icon"></i> @course.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x display-4 d-block mb-3 opacity-50"></i>
                                    <p class="fs-5 mb-0">No courses found in the curriculum.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .shadow-inner {
        box-shadow: inset 0 1px 2px rgba(0,0,0,.075);
    }
</style>