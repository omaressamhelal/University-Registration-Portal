@page
@model Registration.Web.Pages.Enrollments.IndexModel
@{
    ViewData["Title"] = "Enrollment Management";
}

<div class="container-fluid px-4 py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-xl-6 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <span class="fs-4">📚</span>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-1 tracking-tight">Student Enrollments</h2>
                    <p class="text-muted mb-0 fs-6">Manage student course registrations, update statuses, and handle enrollment records.</p>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-7">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <a asp-page="/Students/Index" class="btn btn-light border text-secondary shadow-sm px-3 py-2 rounded-pill fw-semibold">
                    ← Student Directory
                </a>
                <button type="button" class="btn btn-primary shadow px-4 py-2 rounded-pill fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createEnrollmentModal">
                    <span>+</span> New Enrollment
                </button>
            </div>
        </div>
    </div>

    <!-- Success / Error Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">✨</span>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <!-- SERVER-SIDE SEARCH FORM WITH SEMESTER FILTER -->
        <form method="get" class="card-header bg-white border-bottom py-4 px-4">
            <div class="row align-items-center g-3">
                <div class="col-md-4">
                    <div class="input-group input-group-lg bg-light border rounded-pill overflow-hidden shadow-none">
                        <span class="input-group-text bg-transparent border-0 ps-4 text-muted">🔍</span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-0 bg-transparent shadow-none fs-6 ps-2" placeholder="Search student or course...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="SemesterFilter" class="form-select form-select-lg bg-light border rounded-pill px-4 fs-6 shadow-none" onchange="this.form.submit()">
                        <option value="">Filter by Semester (All)</option>
                        @if (Model.SemestersList != null)
                        {
                            foreach (var sem in Model.SemestersList)
                            {
                                <option value="@sem.Id" selected="@(Model.SemesterFilter == sem.Id)">@sem.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="StatusFilter" class="form-select form-select-lg bg-light border rounded-pill px-4 fs-6 shadow-none" onchange="this.form.submit()">
                        <option value="">Filter by Status (All)</option>
                        @if (Model.StatusesList != null)
                        {
                            foreach (var status in Model.StatusesList)
                            {
                                <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 w-100 fw-semibold">Search</button>
                </div>
            </div>
        </form>

        <!-- Table View -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="bg-light text-uppercase fs-7 text-muted fw-bold">
                        <tr>
                            <th class="py-3 ps-4"># ID</th>
                            <th class="py-3">Student Name</th>
                            <th class="py-3">Course Name</th>
                            <th class="py-3">Semester</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EnrollmentsList != null && Model.EnrollmentsList.Any())
                        {
                            foreach (var item in Model.EnrollmentsList)
                            {
                                string badgeClass = item.StatusName switch
                                {
                                    "Passed" => "bg-success text-success border-success",
                                    "Enrolled" => "bg-primary text-primary border-primary",
                                    "Pending" => "bg-warning text-warning border-warning",
                                    "Failed" => "bg-danger text-danger border-danger",
                                    "Dropped" => "bg-dark text-dark border-dark",
                                    _ => "bg-secondary text-secondary border-secondary"
                                };

                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@item.Id</td>
                                    <td class="fw-bold text-dark">@item.StudentName</td>
                                    <td class="text-secondary fw-medium">@item.CourseName</td>
                                    <td>
                                        <span class="badge bg-light text-secondary border px-2.5 py-1">🗓️ @item.SemesterName</span>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass bg-opacity-10 border border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            ● @item.StatusName
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@item.Id" class="d-inline-flex align-items-center gap-1 m-0">
                                                <select name="newStatus" class="form-select form-select-sm bg-light border rounded-pill px-3 shadow-none" style="width: 140px;">
                                                    @if (Model.StatusesList != null)
                                                    {
                                                        foreach (var status in Model.StatusesList)
                                                        {
                                                            <option value="@status" selected="@(item.StatusName == status)">@status</option>
                                                        }
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-light border text-primary fw-semibold rounded-pill px-3 shadow-sm">Save</button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline m-0">
                                                <button type="submit" class="btn btn-sm btn-light border text-danger fw-semibold rounded-pill px-3 shadow-sm" onclick="return confirm('Are you sure you want to drop this enrollment?');">Drop</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <span class="fs-1 d-block mb-2">📂</span>
                                        <p class="mb-0 fw-semibold">No enrollment records found.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- SERVER-SIDE PAGINATION WINDOW -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white py-3 border-top">
                    <nav aria-label="Enrollment Navigation">
                        <ul class="pagination justify-content-center mb-0 align-items-center">

                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3 mx-1 text-primary" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SemesterFilter="@Model.SemesterFilter">Previous</a>
                            </li>

                            @if (Model.VisitedStartPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-circle px-3 mx-1 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" asp-page="./Index" asp-route-currentPage="1" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SemesterFilter="@Model.SemesterFilter">1</a>
                                </li>
                                @if (Model.VisitedStartPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                                }
                            }

                            @for (int i = Model.VisitedStartPage; i <= Model.VisitedEndPage; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link rounded-circle px-3 mx-1 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" asp-page="./Index" asp-route-currentPage="@i" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SemesterFilter="@Model.SemesterFilter">@i</a>
                                </li>
                            }

                            @if (Model.VisitedEndPage < Model.TotalPages)
                            {
                                @if (Model.VisitedEndPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link rounded-circle px-3 mx-1 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" asp-page="./Index" asp-route-currentPage="@Model.TotalPages" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SemesterFilter="@Model.SemesterFilter">@Model.TotalPages</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3 mx-1 text-primary" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-SemesterFilter="@Model.SemesterFilter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }

        </div>
    </div>
</div>

<!-- Create Enrollment Modal -->
<div class="modal fade" id="createEnrollmentModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-light px-4 py-3 border-0">
                    <h5 class="modal-title fw-bold text-dark" id="createModalLabel">Enroll a Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Student</label>
                        <select name="studentId" id="studentSelect" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                            <option value="">-- Select a Student --</option>
                            @if (Model.StudentsList != null)
                            {
                                foreach (var student in Model.StudentsList)
                                {
                                    <option value="@student.Id">@student.StudentName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Course</label>
                        <select name="courseId" id="courseSelect" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                            <option value="">-- Select a Course --</option>
                            @if (Model.CoursesList != null)
                            {
                                foreach (var course in Model.CoursesList)
                                {
                                    <option value="@course.Id">@course.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Initial Status</label>
                        <select name="statusName" class="form-select bg-light border-0 py-2.5 rounded-3">
                            @if (Model.StatusesList != null)
                            {
                                foreach (var status in Model.StatusesList)
                                {
                                    <option value="@status" selected="@(status == "Enrolled")">@status</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-light px-4 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold">Create Enrollment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 CSS & Bootstrap 5 Theme -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <!-- Select2 JavaScript -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#studentSelect, #courseSelect').select2({
                theme: 'bootstrap-5',
                width: '100%',
                dropdownParent: $('#createEnrollmentModal')
            });
        });
    </script>
}