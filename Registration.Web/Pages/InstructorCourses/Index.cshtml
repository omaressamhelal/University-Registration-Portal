@page
@model Registration.Web.Pages.InstructorCourses.IndexModel
@{
    ViewData["Title"] = "Instructor Course Assignments";
}

<div class="container py-4" style="max-width: 1100px; min-height: 90vh;">
    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-lg-5 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <span class="fs-4">📖</span>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-1 tracking-tight">Instructor Course Assignments</h2>
                    <p class="text-muted mb-0 fs-6">Manage faculty course allocations and teaching schedules.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-7 col-md-7">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <!-- 🌟 Updated Button with Back Arrow -->
                <a asp-page="/Instructors/Index" class="btn btn-white bg-white text-dark border shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    ← 👨‍🏫 Instructor Directory
                </a>
                <button type="button" class="btn btn-primary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#newAssignmentModal">
                    <span>+</span> Assign Course
                </button>
                <a asp-page="/AdminDashboard/Index" class="btn btn-light border text-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    ← Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Success / Error Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">✨</span>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <!-- Card Header Toolbar with Search & Semester Filter Dropdown -->
        <div class="card-header bg-white border-bottom py-4 px-4">
            <form method="get" id="filterForm">
                <div class="row align-items-center g-3">
                    <!-- Search Bar -->
                    <div class="col-lg-5 col-md-5">
                        <div class="input-group input-group-lg bg-light border rounded-pill overflow-hidden shadow-none">
                            <span class="input-group-text bg-transparent border-0 ps-4 text-muted">🔍</span>
                            <input type="text" id="searchInput" class="form-control border-0 bg-transparent shadow-none fs-6 ps-2" placeholder="Search by instructor or course...">
                        </div>
                    </div>

                    <!-- Semester Filter Dropdown -->
                    <div class="col-lg-4 col-md-4">
                        <select asp-for="SelectedSemesterId" asp-items="@(new SelectList(Model.SemestersList, "Id", "Name"))" class="form-select form-select-lg bg-light border rounded-pill fs-6 px-4 shadow-none" onchange="document.getElementById('filterForm').submit()">
                            <option value="">Filter by Semester (All)</option>
                        </select>
                    </div>

                    <!-- Search Button & Counter -->
                    <div class="col-lg-3 col-md-3 d-flex align-items-center justify-content-md-end gap-3">
                        <span class="text-muted fw-semibold small text-nowrap">
                            Total: <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2">@(Model.AssignmentsList?.Count ?? 0)</span>
                        </span>
                        <button type="button" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm px-4" onclick="filterTable()">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Table View -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="bg-light text-uppercase fs-7 text-muted fw-bold">
                        <tr>
                            <th class="py-3 ps-4" style="width: 15%;"># ID</th>
                            <th class="py-3" style="width: 35%;">Instructor Name</th>
                            <th class="py-3" style="width: 35%;">Course Name</th>
                            <th class="py-3 text-end pe-4" style="width: 15%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AssignmentsList != null && Model.AssignmentsList.Any())
                        {
                            foreach (var item in Model.AssignmentsList)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@item.Id</td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.InstructorName</span>
                                    </td>
                                    <td>
                                        <span class="text-secondary fw-medium">@item.CourseName</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" asp-route-SelectedSemesterId="@Model.SelectedSemesterId" onsubmit="return confirm('Are you sure you want to remove this assignment?');" class="d-inline m-0">
                                            <button type="submit" class="btn btn-sm btn-light border text-danger fw-semibold rounded-pill px-4 py-2 shadow-sm">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <span class="fs-1 d-block mb-2">📂</span>
                                        <p class="mb-0 fw-semibold">No instructor course assignments found for this filter.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Assign Course Modal -->
<div class="modal fade" id="newAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="AssignCourse">
                <!-- Hidden input automatically locks assignment to the latest/last semester -->
                <input type="hidden" asp-for="NewAssignment.Semester_Id" value="@Model.SemestersList.FirstOrDefault()?.Id" />
                <input type="hidden" name="SelectedSemesterId" value="@Model.SelectedSemesterId" />

                <div class="modal-header bg-light px-4 py-3 border-0">
                    <h5 class="modal-title fw-bold text-dark">Assign Course to Instructor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Instructor</label>
                        <select name="NewAssignment.InstructorId" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                            <option value="" disabled selected>-- Select Instructor --</option>
                            @if (Model.InstructorsList != null)
                            {
                                foreach (var inst in Model.InstructorsList)
                                {
                                    <option value="@inst.Id">@inst.InstructorName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Course</label>
                        <select name="NewAssignment.CourseId" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                            <option value="" disabled selected>-- Select Course --</option>
                            @if (Model.CoursesList != null)
                            {
                                foreach (var crs in Model.CoursesList)
                                {
                                    <option value="@crs.Id">@crs.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-light px-4 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold">Save Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {
                if (row.cells.length < 4) return;

                let instructor = row.cells[1].textContent.toLowerCase();
                let course = row.cells[2].textContent.toLowerCase();

                let matches = instructor.includes(input) || course.includes(input);
                row.style.display = matches ? "" : "none";
            });
        }
    </script>
}