@page
@model Registration.Web.Pages.Instructors.IndexModel
@{
    ViewData["Title"] = "Instructor Directory";
}

<div class="container-fluid px-4 py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-xl-6 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <span class="fs-4">👨‍🏫</span>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-1 tracking-tight">Faculty Instructors</h2>
                    <p class="text-muted mb-0 fs-6">Monitor faculty records, departments, and course assignments.</p>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-7">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <a asp-page="/InstructorCourses/Index" class="btn btn-white bg-white text-dark border shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    📖 Instructor Courses
                </a>
                <button type="button" class="btn btn-primary shadow px-4 py-2 rounded-pill fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#registerInstructorModal">
                    <span>+</span> Register Instructor
                </button>
                <a asp-page="/AdminDashboard/Index" class="btn btn-light border text-secondary shadow-sm px-3 py-2 rounded-pill fw-semibold hover-lift">
                    ← Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Success / Error Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">✨</span>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <!-- Server-side Search Form -->
        <form method="get" class="card-header bg-white border-bottom py-4 px-4">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <div class="input-group input-group-lg bg-light border rounded-pill overflow-hidden shadow-none">
                        <span class="input-group-text bg-transparent border-0 ps-4 text-muted">🔍</span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-0 bg-transparent shadow-none fs-6 ps-2" placeholder="Search by name, email, department...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="StatusFilter" class="form-select form-select-lg bg-light border rounded-pill px-4 fs-6 shadow-none" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @if (Model.StatusesList != null)
                        {
                            foreach (var status in Model.StatusesList)
                            {
                                <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 w-100 fw-semibold">Search</button>
                </div>
            </div>
        </form>

        <!-- Table View -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase fs-7 text-muted fw-bold">
                        <tr>
                            <th class="py-3 ps-4"># ID</th>
                            <th class="py-3">Instructor Name</th>
                            <th class="py-3">Email Address</th>
                            <th class="py-3">Department</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end pe-4" style="min-width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.InstructorsList != null && Model.InstructorsList.Any())
                        {
                            foreach (var instructor in Model.InstructorsList)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@instructor.Id</td>
                                    <td>
                                        <a asp-page="./Details" asp-route-id="@instructor.Id" class="fw-bold text-decoration-none text-primary d-inline-flex align-items-center gap-1">
                                            @instructor.InstructorName <span class="text-muted small">↗</span>
                                        </a>
                                    </td>
                                    <td class="text-muted">@instructor.Email</td>
                                    <td>
                                        @{
                                            var deptCode = Model.DepartmentsList.FirstOrDefault(d => d.Name == instructor.DepartmentName)?.Code ?? "N/A";
                                        }
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold" title="@instructor.DepartmentName">
                                            @deptCode
                                        </span>
                                    </td>

                                    @{
                                        var badgeTheme = instructor.StatusDescription switch
                                        {
                                            "Active" => "bg-success text-success border-success",
                                            "Pending" => "bg-warning text-warning border-warning",
                                            "Retired" => "bg-secondary text-secondary border-secondary",
                                            "Resigned" => "bg-danger text-danger border-danger",
                                            _ => "bg-secondary text-secondary border-secondary"
                                        };
                                    }
                                    <td>
                                        <span class="badge @badgeTheme bg-opacity-10 border border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            ● @instructor.StatusDescription
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border text-primary fw-semibold rounded-pill px-3 py-2 shadow-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editInstructorModal"
                                                data-id="@instructor.Id"
                                                data-name="@instructor.InstructorName"
                                                data-email="@instructor.Email"
                                                data-nationalid="@instructor.National_Id"
                                                data-departmentid="@instructor.Department_Id"
                                                data-departmentname="@instructor.DepartmentName"
                                                data-startyear="@instructor.Start_year"
                                                data-salary="@instructor.Salary"
                                                data-statusid="@instructor.Status_Id"
                                                data-statusdesc="@instructor.StatusDescription"
                                                data-password="@instructor.Password"
                                                data-officehours="@instructor.OfficeHours">
                                            ✏️ Edit Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <span class="fs-1 d-block mb-2">📂</span>
                                        <p class="mb-0 fw-semibold">No instructor records found in the directory.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sliding Window Pagination Footer -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-top">
                <nav aria-label="Instructor Navigation">
                    <ul class="pagination justify-content-center mb-0 align-items-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 mx-1 text-primary" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">Previous</a>
                        </li>

                        @if (Model.VisitedStartPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link rounded-circle px-3 mx-1 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" asp-page="./Index" asp-route-currentPage="1" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">1</a>
                            </li>
                            @if (Model.VisitedStartPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                            }
                        }

                        @for (int i = Model.VisitedStartPage; i <= Model.VisitedEndPage; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link rounded-circle px-3 mx-1 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" asp-page="./Index" asp-route-currentPage="@i" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">@i</a>
                            </li>
                        }

                        @if (Model.VisitedEndPage < Model.TotalPages)
                        {
                            @if (Model.VisitedEndPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link rounded-circle px-3 mx-1 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" asp-page="./Index" asp-route-currentPage="@Model.TotalPages" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">@Model.TotalPages</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 mx-1 text-primary" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Register New Instructor Modal -->
<div class="modal fade" id="registerInstructorModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="RegisterInstructor">
                <div class="modal-header bg-light px-4 py-3 border-0">
                    <h5 class="modal-title fw-bold text-dark" id="registerModalLabel">Register New Faculty Instructor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Full Name</label>
                            <input type="text" name="NewInstructor.Name" class="form-control bg-light border-0 py-2.5 rounded-3" required placeholder="e.g. Dr. Jane Smith">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Email Address</label>
                            <input type="email" name="NewInstructor.Email" class="form-control bg-light border-0 py-2.5 rounded-3" required placeholder="instructor@university.edu.eg">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Password</label>
                            <input type="password" name="NewInstructor.Password" class="form-control bg-light border-0 py-2.5 rounded-3" required placeholder="Initial account password">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">National ID</label>
                            <input type="text" name="NewInstructor.National_Id" class="form-control bg-light border-0 py-2.5 rounded-3" required placeholder="14-digit national ID">
                        </div>

                        <!-- DYNAMIC DEPARTMENT DROPDOWN -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Department</label>
                            <select name="NewInstructor.Department_Id" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled selected>-- Select Department --</option>
                                @if (Model.DepartmentsList != null && Model.DepartmentsList.Any())
                                {
                                    foreach (var dept in Model.DepartmentsList)
                                    {
                                        <option value="@dept.Id">@dept.Code - @dept.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Start Year</label>
                            <input type="number" name="NewInstructor.Start_year" class="form-control bg-light border-0 py-2.5 rounded-3" min="1970" max="2030" value="2026" required>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Account Status</label>
                            <select name="NewInstructor.Status_Id" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled selected>-- Select Status --</option>
                                @if (Model.StatusesList != null && Model.StatusesList.Any())
                                {
                                    int idCounter = 1;
                                    foreach (var statusDesc in Model.StatusesList)
                                    {
                                        <option value="@idCounter">@statusDesc</option>
                                        idCounter++;
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Salary ($)</label>
                            <input type="number" step="any" name="NewInstructor.Salary" class="form-control bg-light border-0 py-2.5 rounded-3" min="1" value="12000" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Office Hours</label>
                            <input type="text" name="NewInstructor.OfficeHours" class="form-control bg-light border-0 py-2.5 rounded-3" placeholder="e.g. Mon/Wed 2-4 PM">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-light px-4 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold">Complete Registration</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Instructor Modal -->
<div class="modal fade" id="editInstructorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="UpdateInstructor">
                <input type="hidden" id="editInstructorId" name="NewInstructor.Id" />
                <input type="hidden" id="editPassword" name="NewInstructor.Password" />
                <div class="modal-header bg-light px-4 py-3 border-0">
                    <h5 class="modal-title fw-bold text-dark">Edit Instructor Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Full Name</label>
                            <input type="text" id="editName" name="NewInstructor.Name" class="form-control bg-light border-0 py-2.5 rounded-3" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Email Address</label>
                            <input type="email" id="editEmail" name="NewInstructor.Email" class="form-control bg-light border-0 py-2.5 rounded-3" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">National ID</label>
                            <input type="text" id="editNationalId" name="NewInstructor.National_Id" class="form-control bg-light border-0 py-2.5 rounded-3" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Department</label>
                            <select id="editDepartmentId" name="NewInstructor.Department_Id" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled>-- Select Department --</option>
                                @if (Model.DepartmentsList != null)
                                {
                                    foreach (var dept in Model.DepartmentsList)
                                    {
                                        <option value="@dept.Id">@dept.Code - @dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Start Year</label>
                            <input type="number" id="editStartYear" name="NewInstructor.Start_year" class="form-control bg-light border-0 py-2.5 rounded-3" min="1970" max="2030" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Account Status</label>
                            <select id="editStatusId" name="NewInstructor.Status_Id" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled>-- Select Status --</option>
                                @if (Model.StatusesList != null && Model.StatusesList.Any())
                                {
                                    int idCounter = 1;
                                    foreach (var statusDescription in Model.StatusesList)
                                    {
                                        <option value="@idCounter">@statusDescription</option>
                                        idCounter++;
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Salary ($)</label>
                            <input type="number" step="any" id="editSalary" name="NewInstructor.Salary" class="form-control bg-light border-0 py-2.5 rounded-3" min="1" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Office Hours</label>
                            <input type="text" id="editOfficeHours" name="NewInstructor.OfficeHours" class="form-control bg-light border-0 py-2.5 rounded-3" placeholder="e.g. Mon/Wed 2-4 PM">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-light px-4 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = document.getElementById('editInstructorModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            let button = event.relatedTarget;
            document.getElementById('editInstructorId').value = button.getAttribute('data-id');
            document.getElementById('editName').value = button.getAttribute('data-name');
            document.getElementById('editEmail').value = button.getAttribute('data-email');
            document.getElementById('editNationalId').value = button.getAttribute('data-nationalid');
            document.getElementById('editStartYear').value = button.getAttribute('data-startyear');
            document.getElementById('editSalary').value = button.getAttribute('data-salary');
            document.getElementById('editPassword').value = button.getAttribute('data-password');

            // Office Hours
            let officeHoursVal = button.getAttribute('data-officehours');
            document.getElementById('editOfficeHours').value = (officeHoursVal === 'Not specified yet' || !officeHoursVal) ? '' : officeHoursVal;

            // 🌟 Robust Department Selection (Matches by ID or Department Name text)
            let deptId = button.getAttribute('data-departmentid');
            let deptName = button.getAttribute('data-departmentname');
            let deptSelect = document.getElementById('editDepartmentId');

            deptSelect.value = deptId;
            if ((!deptSelect.value || deptSelect.value === "") && deptName) {
                for (let option of deptSelect.options) {
                    if (option.text.toLowerCase().includes(deptName.trim().toLowerCase())) {
                        deptSelect.value = option.value;
                        break;
                    }
                }
            }

            // 🌟 Robust Status Selection (Matches by ID or Text Description)
            let statusId = button.getAttribute('data-statusid');
            let statusDesc = button.getAttribute('data-statusdesc');
            let statusSelect = document.getElementById('editStatusId');

            statusSelect.value = statusId;
            if ((!statusSelect.value || statusSelect.value === "") && statusDesc) {
                for (let option of statusSelect.options) {
                    if (option.text.toLowerCase() === statusDesc.trim().toLowerCase()) {
                        statusSelect.value = option.value;
                        break;
                    }
                }
            }
        });
    </script>
}