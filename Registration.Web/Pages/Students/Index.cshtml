@page
@model Registration.Web.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Student Directory";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid px-4 py-4" style="min-height: 90vh;">
    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-xl-6 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <i class="bi bi-mortarboard-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="fw-bolder mb-1 text-dark" style="letter-spacing: -0.5px;">University Students</h2>
                    <p class="text-muted mb-0 fs-6">Manage student directory profiles, academic performance, and statuses.</p>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-7">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <a asp-page="/Enrollments/Index" class="btn bg-white border shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-journals text-primary"></i> Enrollments
                </a>
                <button type="button" class="btn btn-primary shadow-sm px-4 py-2 rounded-pill fw-semibold d-flex align-items-center gap-2 hover-lift" data-bs-toggle="modal" data-bs-target="#registerStudentModal">
                    <i class="bi bi-plus-lg"></i> Register Student
                </button>
                <a asp-page="/AdminDashboard/Index" class="btn btn-light border text-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Success / Error Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success py-3 px-4 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
            <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <!-- Card Header Toolbar with GET Form for Server-side Search & Filter -->
        <form method="get" class="card-header bg-white border-bottom py-4 px-4">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <div class="input-group input-group-lg bg-light rounded-pill overflow-hidden border border-light-subtle transition-hover focus-ring-group">
                        <span class="input-group-text bg-transparent border-0 ps-4 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-0 bg-transparent shadow-none fs-6 ps-2" placeholder="Search by student name, email, department...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="StatusFilter" asp-for="StatusFilter" class="form-select form-select-lg bg-light border border-light-subtle rounded-pill px-4 fs-6 shadow-none transition-hover" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @if (Model.StatusesList != null)
                        {
                            foreach (var status in Model.StatusesList)
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2.5 w-100 fw-semibold shadow-sm hover-lift">Search</button>
                </div>
            </div>
        </form>

        <!-- Table View -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-borderless">
                    <thead class="text-uppercase fs-7 text-dark fw-bold bg-white">
                        <tr class="border-bottom">
                            <th class="py-3 ps-4 rounded-top-start"># ID</th>
                            <th class="py-3">Student Name</th>
                            <th class="py-3">Email Address</th>
                            <th class="py-3">Department</th>
                            <th class="py-3">GPA</th>
                            <th class="py-3 text-center">Year</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end pe-4 rounded-top-end" style="min-width: 130px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StudentsList != null && Model.StudentsList.Any())
                        {
                            foreach (var student in Model.StudentsList)
                            {
                                <tr class="border-bottom border-light-subtle hover-bg-light transition-hover">
                                    <td class="ps-4 fw-bold text-dark">@student.Id</td>
                                    <td>
                                        <a asp-page="./Details" asp-route-id="@student.Id" class="fw-bold text-decoration-none text-primary d-inline-flex align-items-center gap-1 hover-link">
                                            @student.StudentName <i class="bi bi-box-arrow-up-right small ms-1" style="font-size: 0.75rem;"></i>
                                        </a>
                                    </td>
                                    <td class="text-muted fw-medium fs-6">
                                        @student.Email
                                    </td>
                                    <td>
                                        <span class="badge bg-white text-dark border border-secondary-subtle px-3 py-2 rounded-pill fw-semibold" title="@student.DepartmentName">
                                            @student.DepartmentCode
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning-subtle px-3 py-2 rounded-pill fw-bold shadow-sm">
                                            <i class="bi bi-star-fill text-warning me-1"></i> @student.Gpa.ToString("0.00")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted fw-medium fs-6">
                                            Year @student.Year
                                        </span>
                                    </td>

                                    @{
                                        var badgeTheme = student.Description switch
                                        {
                                            "Active" => "bg-success text-success border-success-subtle",
                                            "Pending" or "Deferred" => "bg-warning text-dark border-warning-subtle",
                                            "Suspended" => "bg-danger text-danger border-danger-subtle",
                                            "Graduated" => "bg-primary text-primary border-primary-subtle",
                                            "Transferred" => "bg-info text-dark border-info-subtle",
                                            "Dismissed" or "Expelled" => "bg-dark text-white border-dark",
                                            "On Leave" => "bg-secondary text-secondary border-secondary-subtle",
                                            _ => "bg-secondary text-secondary border-secondary-subtle"
                                        };
                                    }
                                    <td>
                                        <span class="badge @badgeTheme bg-opacity-10 border px-3 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-circle-fill" style="font-size: 0.4rem;"></i> @student.Description
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- UPDATED: Edit Details Button -->
                                        <button type="button" class="btn btn-sm bg-white border border-secondary-subtle text-primary fw-semibold rounded-pill px-3 py-1.5 shadow-sm transition-hover d-inline-flex align-items-center gap-2 hover-bg-light"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editStudentModal"
                                                data-id="@student.Id"
                                                data-name="@student.StudentName"
                                                data-email="@student.Email"
                                                data-nationalid="@student.National_Id"
                                                data-departmentcode="@student.DepartmentCode"
                                                data-year="@student.Year"
                                                data-gpa="@student.Gpa"
                                                data-statusdescription="@student.Description"
                                                data-password="@student.Password">
                                            <span style="font-size: 0.9rem;">✏️</span> Edit Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <i class="bi bi-folder2-open display-4 d-block mb-3 text-secondary opacity-50"></i>
                                        <p class="mb-0 fs-5 fw-medium text-dark">No student records found.</p>
                                        <p class="small">Try adjusting your search or filters.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-4 border-top">
                <nav aria-label="Student Navigation">
                    <ul class="pagination justify-content-center mb-0 gap-1">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 fw-medium text-primary border-primary-subtle bg-light" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link rounded-circle d-inline-flex align-items-center justify-content-center fw-semibold shadow-sm @(Model.CurrentPage == i ? "bg-primary text-white" : "text-primary border-primary-subtle bg-white")" style="width: 38px; height: 38px;" asp-page="./Index" asp-route-currentPage="@i" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 fw-medium text-primary border-primary-subtle bg-light" asp-page="./Index" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Register New Student Modal -->
<div class="modal fade" id="registerStudentModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="RegisterStudent">
                <div class="modal-header bg-light px-4 py-3 border-bottom border-light-subtle">
                    <h5 class="modal-title fw-bold text-dark" id="registerModalLabel"><i class="bi bi-person-plus text-primary me-2"></i>Register New Student Account</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 p-md-5">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Full Name</label>
                            <input type="text" name="NewStudent.Name" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required placeholder="e.g. John Doe">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Email Address</label>
                            <input type="email" name="NewStudent.Email" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required placeholder="student@univ.edu.eg">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Password</label>
                            <input type="password" name="NewStudent.Password" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required placeholder="Initial account password">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">National ID</label>
                            <input type="text" name="NewStudent.National_Id" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required placeholder="14-digit national ID">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Department</label>
                            <select name="NewStudent.DepartmentCode" class="form-select border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required>
                                <option value="" disabled selected>-- Select Department --</option>
                                @if (Model.DepartmentsList != null && Model.DepartmentsList.Any())
                                {
                                    foreach (var dept in Model.DepartmentsList)
                                    {
                                        <option value="@dept.Code">@dept.Code - @dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Academic Year</label>
                            <input type="number" name="NewStudent.Year" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" min="1" max="5" value="1" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Initial GPA</label>
                            <input type="number" step="0.01" name="NewStudent.Gpa" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" min="0" max="4.0" value="0.00" required>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Account Status</label>
                            <select name="NewStudent.StatusDescription" class="form-select border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required>
                                <option value="" disabled selected>-- Select Status --</option>
                                @if (Model.StatusesList != null && Model.StatusesList.Any())
                                {
                                    foreach (var statusDesc in Model.StatusesList)
                                    {
                                        <option value="@statusDesc">@statusDesc</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4 py-3 border-top border-light-subtle bg-white">
                    <button type="button" class="btn border px-4 rounded-pill fw-semibold text-secondary hover-bg-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold hover-lift">Complete Registration</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editStudentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="UpdateStudent">
                <input type="hidden" id="editStudentId" name="NewStudent.Id" />
                <input type="hidden" id="editPassword" name="NewStudent.Password" />
                <div class="modal-header bg-light px-4 py-3 border-bottom border-light-subtle">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Student Details</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 p-md-5">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Full Name</label>
                            <input type="text" id="editName" name="NewStudent.Name" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Email Address</label>
                            <input type="email" id="editEmail" name="NewStudent.Email" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">National ID</label>
                            <input type="text" id="editNationalId" name="NewStudent.National_Id" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Department</label>
                            <select id="editDepartmentCode" name="NewStudent.DepartmentCode" class="form-select border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required>
                                <option value="" disabled>-- Select Department --</option>
                                @if (Model.DepartmentsList != null)
                                {
                                    foreach (var dept in Model.DepartmentsList)
                                    {
                                        <option value="@dept.Code">@dept.Code - @dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Academic Year</label>
                            <input type="number" id="editYear" name="NewStudent.Year" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" min="1" max="5" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">GPA</label>
                            <input type="number" step="0.01" id="editGpa" name="NewStudent.Gpa" class="form-control border-light-subtle py-2.5 rounded-3 bg-light transition-hover" min="0" max="4.0" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Account Status</label>
                            <select id="editStatusDescription" name="NewStudent.StatusDescription" class="form-select border-light-subtle py-2.5 rounded-3 bg-light transition-hover" required>
                                <option value="" disabled>-- Select Status --</option>
                                @if (Model.StatusesList != null && Model.StatusesList.Any())
                                {
                                    foreach (var statusDescription in Model.StatusesList)
                                    {
                                        <option value="@statusDescription">@statusDescription</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4 py-3 border-top border-light-subtle bg-white">
                    <button type="button" class="btn border px-4 rounded-pill fw-semibold text-secondary hover-bg-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold hover-lift">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .hover-bg-light:hover {
        background-color: #f8f9fa;
    }

    .transition-hover {
        transition: all 0.2s ease;
    }

        .transition-hover:focus {
            background-color: #fff !important;
            border-color: #0d6efd !important;
            box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25) !important;
        }

    .hover-link:hover {
        text-decoration: underline !important;
    }

    .focus-ring-group:focus-within {
        background-color: #fff !important;
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25) !important;
    }
</style>

@section Scripts {
    <script>
        const editModal = document.getElementById('editStudentModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            let button = event.relatedTarget;
            document.getElementById('editStudentId').value = button.getAttribute('data-id');
            document.getElementById('editName').value = button.getAttribute('data-name');
            document.getElementById('editEmail').value = button.getAttribute('data-email');
            document.getElementById('editNationalId').value = button.getAttribute('data-nationalid');
            document.getElementById('editDepartmentCode').value = button.getAttribute('data-departmentcode');
            document.getElementById('editYear').value = button.getAttribute('data-year');
            document.getElementById('editGpa').value = button.getAttribute('data-gpa');
            document.getElementById('editStatusDescription').value = button.getAttribute('data-statusdescription');
            document.getElementById('editPassword').value = button.getAttribute('data-password');
        });
    </script>
}