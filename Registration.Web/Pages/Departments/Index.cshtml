@page
@model Registration.Web.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Academic Departments";
}

<div class="container-fluid px-4 py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-xl-6 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <span class="fs-4">🏛️</span>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-1 tracking-tight">Academic Departments</h2>
                    <p class="text-muted mb-0 fs-6">Oversee academic departments and faculty divisions.</p>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-7">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <button type="button" class="btn btn-primary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
                    + Add Department
                </button>
                <a href="/AdminDashboard" class="btn btn-light border text-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    ← Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Error Alert Banner -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Success Alert Banner -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">✅</span>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="bg-light text-uppercase fs-7 text-muted fw-bold">
                        <tr>
                            <th class="py-3 ps-4" style="width: 10%;"># ID</th>
                            <th class="py-3" style="width: 15%;">Code</th>
                            <th class="py-3" style="width: 30%;">Department Name</th>
                            <th class="py-3" style="width: 30%;">Overview Statistics</th>
                            <th class="py-3 text-end pe-4" style="min-width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DepartmentsList != null && Model.DepartmentsList.Any())
                        {
                            foreach (var dept in Model.DepartmentsList)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@dept.Id</td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            @dept.Code
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark py-3">@dept.Name</td>
                                    <td style="max-width: 380px;">
                                        <div class="d-flex flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-1 text-primary fw-semibold bg-primary bg-opacity-10 px-3 py-1.5 rounded-pill" style="font-size: 0.85rem;">
                                                <span>🎓</span> @dept.TotalStudents Students
                                            </div>
                                            <div class="d-flex align-items-center gap-1 text-info fw-semibold bg-info bg-opacity-10 px-3 py-1.5 rounded-pill" style="font-size: 0.85rem;">
                                                <span>👨‍🏫</span> @dept.TotalInstructors Instructors
                                            </div>
                                            <div class="d-flex align-items-center gap-1 text-secondary fw-semibold bg-secondary bg-opacity-10 px-3 py-1.5 rounded-pill" style="font-size: 0.85rem;">
                                                <span>📚</span> @dept.TotalCourses Courses
                                            </div>
                                            <div class="d-flex align-items-center gap-1 text-success fw-semibold bg-success bg-opacity-10 px-3 py-1.5 rounded-pill" style="font-size: 0.85rem;">
                                                <span>⭐</span> @dept.AverageGpa.ToString("0.00") Avg GPA
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border text-primary fw-semibold rounded-pill px-3 py-1 shadow-sm d-inline-flex align-items-center gap-1" onclick="openEditModal(@dept.Id)">
                                            ✏️ Edit Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <span class="fs-1 d-block mb-2">🏛️</span>
                                        <p class="mb-0 fw-semibold">No departments found in the system.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add New Department Modal Popup -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1" aria-labelledby="addDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-dark" id="addDepartmentModalLabel">Add New Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form method="post" asp-page-handler="CreateModal" onsubmit="prepareCreateForm()">
                    <!-- Hidden field to satisfy Name_AR requirement silently -->
                    <input type="hidden" id="addDeptNameAr" name="NewDepartment.Name_AR" />

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Department Name</label>
                        <input type="text" id="addDeptName" name="NewDepartment.Name" class="form-control form-control-lg rounded-3 border-light bg-light" placeholder="e.g. Mechanical Engineering" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Department Code</label>
                        <input type="text" name="NewDepartment.Code" class="form-control form-control-lg rounded-3 border-light bg-light" placeholder="e.g. MEE" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <button type="button" class="btn btn-light px-4 py-2.5 rounded-pill fw-semibold text-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-5 py-2.5 rounded-pill fw-semibold shadow-sm">Create Department</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Department Modal Popup Container -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-dark" id="editDepartmentModalLabel">Edit Department Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form method="post" asp-page-handler="SaveModal">
                    <input type="hidden" id="editDeptId" name="Department.Id" />
                    <input type="hidden" id="editDeptNameAr" name="Department.Name_AR" />

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Department Name</label>
                        <input type="text" id="editDeptName" name="Department.Name" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Department Code</label>
                        <input type="text" id="editDeptCode" name="Department.Code" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <button type="button" class="btn btn-light px-4 py-2.5 rounded-pill fw-semibold text-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-5 py-2.5 rounded-pill fw-semibold shadow-sm">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepareCreateForm() {
            var nameValue = document.getElementById('addDeptName').value;
            document.getElementById('addDeptNameAr').value = nameValue;
        }

        function openEditModal(departmentId) {
            fetch(`/Departments?handler=DepartmentJson&id=` + departmentId)
                .then(response => response.json())
                .then(dept => {
                    document.getElementById('editDeptId').value = dept.id;
                    document.getElementById('editDeptName').value = dept.name;
                    document.getElementById('editDeptNameAr').value = dept.name_AR || dept.name;
                    document.getElementById('editDeptCode').value = dept.code;

                    var myModal = new bootstrap.Modal(document.getElementById('editDepartmentModal'));
                    myModal.show();
                })
                .catch(error => {
                    alert("Error loading department details.");
                });
        }
    </script>
}