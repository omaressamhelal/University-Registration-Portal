@page
@model Registration.Web.Pages.Admins.IndexModel
@{
    ViewData["Title"] = "Manage Admins";
}

<div class="container-fluid px-4 py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-xl-6 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <span class="fs-4">🛡️</span>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-1 tracking-tight">System Administrators</h2>
                    <p class="text-muted mb-0 fs-6">Add, edit, or update administrator profiles and system permissions.</p>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-7">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <button type="button" class="btn btn-primary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift" data-bs-toggle="modal" data-bs-target="#addAdminModal">
                    + Add Administrator
                </button>
                <a href="/AdminDashboard" class="btn btn-light border text-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    ← Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Banners -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success py-3 px-4">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">✅</span>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <!-- Search Toolbar -->
        <div class="card-header bg-white border-bottom py-4 px-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-5 col-md-6">
                    <div class="input-group input-group-lg bg-light border rounded-pill overflow-hidden shadow-none">
                        <span class="input-group-text bg-transparent border-0 ps-4 text-muted">🔍</span>
                        <input type="text" id="searchInput" class="form-control border-0 bg-transparent shadow-none fs-6 ps-2" placeholder="Search by name, email, or role...">
                    </div>
                </div>
                <div class="col-lg-4 col-md-4">
                    <select id="statusFilter" class="form-select form-select-lg bg-light border rounded-pill px-4 fs-6 shadow-none" onchange="filterTable()">
                        <option value="">All Statuses</option>
                        @if (Model.AllStatusesList != null)
                        {
                            foreach (var st in Model.AllStatusesList)
                            {
                                <option value="@st.Description">@st.Description</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-2 text-md-end">
                    <button type="button" class="btn btn-primary btn-lg w-100 rounded-pill fw-semibold shadow-sm px-4" onclick="filterTable()">
                        Search
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap" id="adminsTable">
                    <thead class="bg-light text-uppercase fs-7 text-muted fw-bold">
                        <tr>
                            <th class="py-3 ps-4" style="width: 5%;"># ID</th>
                            <th class="py-3" style="width: 20%;">Name</th>
                            <th class="py-3" style="width: 20%;">Email</th>
                            <th class="py-3" style="width: 15%;">Role</th>
                            <th class="py-3" style="width: 15%;">Salary</th>
                            <th class="py-3" style="width: 15%;">Status</th>
                            <th class="py-3 text-end pe-4" style="width: 10%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AdminsList != null && Model.AdminsList.Any())
                        {
                            foreach (var admin in Model.AdminsList)
                            {
                                string badgeColorClass = admin.StatusDescription switch
                                {
                                    "Active" => "bg-success text-success border-success",
                                    "Suspended" => "bg-danger text-danger border-danger",
                                    "Inactive" => "bg-secondary text-secondary border-secondary",
                                    "Pending" => "bg-warning text-dark border-warning",
                                    _ => "bg-dark text-dark border-dark"
                                };

                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@admin.Id</td>
                                    <td class="py-3">
                                        <a href="/Admins/Details/@admin.Id" class="fw-bold text-primary text-decoration-none d-inline-flex align-items-center gap-1">
                                            @admin.Name <span style="font-size: 0.85em;">↗</span>
                                        </a>
                                    </td>
                                    <td class="text-secondary">@admin.Email</td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            🔑 @admin.Role
                                        </span>
                                    </td>
                                    <td class="text-secondary fw-medium">
                                        @if (!string.IsNullOrEmpty(admin.Email) && admin.Email.Equals(User.Identity?.Name, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="text-success fw-bold">$@admin.Salary.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">🔒 Confidential</span>
                                        }
                                    </td>
                                    <td data-status="@admin.StatusDescription">
                                        <span class="badge @badgeColorClass bg-opacity-10 border border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            ● @admin.StatusDescription
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border text-primary fw-semibold rounded-pill px-3 py-1 shadow-sm" onclick="openEditModal(@admin.Id, '@admin.StatusDescription')">
                                            ✏️ Edit Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <span class="fs-1 d-block mb-2">🛡️</span>
                                        <p class="mb-0 fw-semibold">No administrators found in the system.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Admin Modal -->
<div class="modal fade" id="addAdminModal" tabindex="-1" aria-labelledby="addAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-dark" id="addAdminModalLabel">Add New Administrator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form method="post" asp-page-handler="Create">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Full Name</label>
                            <input type="text" name="NewAdmin.Name" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Email Address</label>
                            <input type="email" name="NewAdmin.Email" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Password</label>
                            <input type="password" name="NewAdmin.Password" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">National ID</label>
                            <input type="text" name="NewAdmin.National_id" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Start Year</label>
                            <input type="number" name="NewAdmin.Start_year" class="form-control form-control-lg rounded-3 border-light bg-light" value="2026" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Salary ($)</label>
                            <input type="number" step="0.01" name="NewAdmin.Salary" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Account Status</label>
                            <select name="NewAdmin.Status_id" class="form-select form-select-lg rounded-3 border-light bg-light" required>
                                <option value="">-- Select Status --</option>
                                @if (Model.AllStatusesList != null)
                                {
                                    foreach (var st in Model.AllStatusesList)
                                    {
                                        <option value="@st.Id">@st.Description</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Role Privilege</label>
                        <input type="text" name="NewAdmin.Role" class="form-control form-control-lg rounded-3 border-light bg-light" placeholder="e.g. Lead Developer, System Admin" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <button type="button" class="btn btn-light px-4 py-2.5 rounded-pill fw-semibold text-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-5 py-2.5 rounded-pill fw-semibold shadow-sm">Create Admin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Admin Modal -->
<div class="modal fade" id="editAdminModal" tabindex="-1" aria-labelledby="editAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-dark" id="editAdminModalLabel">Edit Administrator Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <form method="post" asp-page-handler="SaveModal">
                    <input type="hidden" id="editAdminId" name="Admin.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Full Name</label>
                            <input type="text" id="editName" name="Admin.Name" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Email Address</label>
                            <input type="email" id="editEmail" name="Admin.Email" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">National ID</label>
                            <input type="text" id="editNationalId" name="Admin.National_id" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Start Year</label>
                            <input type="number" id="editStartYear" name="Admin.Start_year" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Salary ($)</label>
                            <input type="number" step="0.01" id="editSalary" name="Admin.Salary" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">Account Status</label>
                            <select id="editStatusId" name="Admin.Status_id" class="form-select form-select-lg rounded-3 border-light bg-light" required>
                                <option value="">-- Select Status --</option>
                                @if (Model.AllStatusesList != null)
                                {
                                    foreach (var st in Model.AllStatusesList)
                                    {
                                        <option value="@st.Id">@st.Description</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Role Privilege</label>
                        <input type="text" id="editRole" name="Admin.Role" class="form-control form-control-lg rounded-3 border-light bg-light" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <button type="button" class="btn btn-light px-4 py-2.5 rounded-pill fw-semibold text-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-5 py-2.5 rounded-pill fw-semibold shadow-sm">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let selectedStatus = document.getElementById("statusFilter").value.toLowerCase();
            let rows = document.querySelectorAll("#adminsTable tbody tr");

            rows.forEach(row => {
                if (row.cells.length < 7) return;

                let name = row.cells[1].textContent.toLowerCase();
                let email = row.cells[2].textContent.toLowerCase();
                let role = row.cells[3].textContent.toLowerCase();
                let rowStatus = row.cells[5].getAttribute("data-status") ? row.cells[5].getAttribute("data-status").toLowerCase() : "";

                let matchesSearch = name.includes(input) || email.includes(input) || role.includes(input);
                let matchesStatus = selectedStatus === "" || rowStatus.includes(selectedStatus);

                if (matchesSearch && matchesStatus) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function openEditModal(adminId, statusDescription) {
            // 1. Pre-select status dropdown immediately
            let statusDropdown = document.getElementById('editStatusId');
            statusDropdown.value = "";
            if (statusDescription) {
                for (let option of statusDropdown.options) {
                    if (option.text.toLowerCase() === statusDescription.trim().toLowerCase()) {
                        statusDropdown.value = option.value;
                        break;
                    }
                }
            }

            // 2. Fetch admin details from API
            fetch(`/Admins?handler=AdminJson&id=` + adminId)
                .then(response => response.json())
                .then(admin => {
                    console.log("Fetched Admin JSON:", admin);

                    document.getElementById('editAdminId').value = admin.id || admin.Id || '';
                    document.getElementById('editName').value = admin.name || admin.Name || '';
                    document.getElementById('editEmail').value = admin.email || admin.Email || '';
                    document.getElementById('editStartYear').value = admin.start_year || admin.startYear || admin.Start_year || '';
                    document.getElementById('editSalary').value = admin.salary || admin.Salary || '';
                    document.getElementById('editRole').value = admin.role || admin.Role || '';

                    // 🌟 Bulletproof dynamic property finder for National ID (ignores case & underscores)
                    let natIdValue = '';
                    for (let key in admin) {
                        if (key.toLowerCase().replace(/[^a-z0-9]/g, '') === 'nationalid') {
                            natIdValue = admin[key];
                            break;
                        }
                    }
                    document.getElementById('editNationalId').value = natIdValue || '';

                    var myModal = new bootstrap.Modal(document.getElementById('editAdminModal'));
                    myModal.show();
                })
                .catch(error => {
                    console.error("Error loading admin details:", error);
                    alert("Error loading admin details.");
                });
        }
    </script>
}