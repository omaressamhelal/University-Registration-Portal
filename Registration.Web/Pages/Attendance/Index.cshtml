@page
@model Registration.Web.Pages.Attendance.IndexModel
@{
    ViewData["Title"] = "Attendance Logs";
}

<div class="container mt-4">
    <h2>System Attendance Records</h2>

    <!-- Filter Controls -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <label for="filterScheduleId" class="form-label">Schedule ID</label>
            <input type="number" id="filterScheduleId" class="form-control" placeholder="Optional" />
        </div>
        <div class="col-md-3">
            <label for="filterDate" class="form-label">Attendance Date</label>
            <input type="date" id="filterDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="filterStudentId" class="form-label">Student ID</label>
            <input type="number" id="filterStudentId" class="form-control" placeholder="Optional" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button id="searchBtn" class="btn btn-primary w-100">Filter Records</button>
        </div>
    </div>

    <!-- Attendance Table Grid -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Course Code & Name</th>
                    <th>Schedule Day / Time</th>
                    <th>Student Name</th>
                </tr>
            </thead>
            <tbody id="attendanceTableBody">
                <tr>
                    <td colspan="5" class="text-center text-muted">Loading logs...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function loadAttendanceRecords() {
            const scheduleId = document.getElementById('filterScheduleId').value;
            const date = document.getElementById('filterDate').value;
            const studentId = document.getElementById('filterStudentId').value;

            let params = new URLSearchParams();
            if (scheduleId) params.append('courseScheduleId', scheduleId);
            if (date) params.append('attendanceDate', date);
            if (studentId) params.append('studentId', studentId);

            try {
                let response = await fetch(`/api/attendance?${params.toString()}`);
                if (!response.ok) {
                    throw new Error("Failed to fetch attendance logs.");
                }

                let records = await response.json();
                let tbody = document.getElementById('attendanceTableBody');
                tbody.innerHTML = '';

                if (records.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" class="text-center text-warning">No attendance records found matching criteria.</td></tr>`;
                    return;
                }

                records.forEach(r => {
                    let formattedDate = new Date(r.attendanceDate).toLocaleDateString();

                    let tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${r.id}</td>
                        <td>${formattedDate}</td>
                        <td><strong>${r.courseCode}</strong> - ${r.courseName}</td>
                        <td>${r.scheduleDay} (${r.startTime} - ${r.endTime})</td>
                        <td>${r.studentName} (ID: ${r.student_Id})</td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error(err);
                document.getElementById('attendanceTableBody').innerHTML = `<tr><td colspan="5" class="text-center text-danger">Error loading data from server.</td></tr>`;
            }
        }

        document.getElementById('searchBtn').addEventListener('click', loadAttendanceRecords);

        // Load all records automatically on page load
        loadAttendanceRecords();
    </script>
}