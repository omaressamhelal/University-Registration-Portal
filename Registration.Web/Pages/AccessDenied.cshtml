@page
@{
    ViewData["Title"] = "Access Denied";
    Layout = null; // 🌟 Hides the main layout so it looks clean and isolated like the login page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniPortal</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
            min-height: 100vh;
        }

        .auth-card {
            border: none;
            box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.08);
            border-radius: 1.5rem;
            background: #ffffff;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .auth-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.12);
            }

        .btn-primary-gradient {
            background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
            border: none;
            transition: all 0.2s ease;
        }

            .btn-primary-gradient:hover {
                filter: brightness(1.05);
                transform: translateY(-1px);
                box-shadow: 0 0.5rem 1rem rgba(13, 110, 253, 0.25);
            }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-4">

    <div class="container-fluid d-flex align-items-center justify-content-center">
        <div class="card auth-card text-center p-5" style="max-width: 500px; width: 100%;">
            <div class="card-body p-4">
                <!-- Icon Container -->
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex justify-content-center align-items-center mx-auto mb-4 shadow-sm" style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-exclamation fs-1"></i>
                </div>

                <h2 class="fw-bolder text-dark mb-2" style="letter-spacing: -0.5px;">Access Denied</h2>
                <p class="text-muted mb-4 fs-6">Oops! You do not have the required role or permissions to view this secure portal.</p>

                <div class="d-flex flex-column gap-2">
                    <a href="/Login/Index" class="btn btn-primary-gradient rounded-pill py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 text-white">
                        <i class="bi bi-box-arrow-in-right"></i> Return to Login
                    </a>
                </div>
            </div>
        </div>
    </div>

</body>
</html>