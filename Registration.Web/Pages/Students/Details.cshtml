@page "{id:int}"
@model Registration.Web.Pages.Students.DetailsModel
@{
    ViewData["Title"] = "Student Profile Details";
}

<div class="container mt-4 mb-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">Student Profile</h2>
            <p class="text-muted mb-0">Detailed academic records and personal details.</p>
        </div>
        <div>
            <a asp-page="/Students/Index" class="btn btn-outline-secondary shadow-sm px-4">← Back to Directory</a>
        </div>
    </div>

    <!-- Success / Error Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5">✅</span>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5">⚠️</span>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.StudentDetailsView == null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0">Student record not found.</div>
    }
    else
    {
        <div class="row g-4 justify-content-center">
            <!-- Left Column: Personal & Academic Summary Card -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 p-4 text-center h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <div class="mb-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-1 shadow-sm mx-auto" style="width: 90px; height: 90px;">
                                @Model.StudentDetailsView.StudentName.Substring(0, 1).ToUpper()
                            </div>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">@Model.StudentDetailsView.StudentName</h4>
                        <p class="text-muted small mb-4">@Model.StudentDetailsView.Email</p>

                        <div class="w-100 text-start border-top pt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">National ID:</span>
                                <span class="fw-semibold text-dark">@Model.StudentDetailsView.National_Id</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Department:</span>
                                <span class="fw-semibold text-dark text-end">@Model.StudentDetailsView.DepartmentName <small class="text-muted">(@Model.StudentDetailsView.DepartmentCode)</small></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Academic Year:</span>
                                <span class="fw-semibold text-dark">Year @Model.StudentDetailsView.Year</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted">Cumulative GPA:</span>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill fw-bold">@Model.StudentDetailsView.Gpa</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Course Enrollments & Account Status Management -->
            <div class="col-lg-8">
                <!-- ENROLLED COURSES BOX -->
                <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold text-dark mb-3 d-flex align-items-center">
                            <span class="me-2">📚</span> Enrolled Courses
                        </h5>
                        <!-- FIX: The overflow-auto and max-height are now placed here on the courses container -->
                        <div class="p-3 bg-light rounded-3 mb-2 overflow-auto" style="max-height: 260px;">
                            @if (Model.StudentDetailsView.EnrolledCoursesList != null && Model.StudentDetailsView.EnrolledCoursesList.Any())
                            {
                                // courseNames is already a list now, no need to split!
                                var courseNames = Model.StudentDetailsView.EnrolledCoursesList.ToList();
                                var courseCodes = Model.StudentDetailsView.CourseCodes?.Split(',') ?? new string[0];
                                // NEW:
                                for (int i = 0; i < courseNames.Count; i++)
                                {
                                    <div class="mb-2">
                                        <div class="fw-semibold text-dark">@courseNames[i].Trim()</div>
                                        @if (i < courseCodes.Length)
                                        {
                                            <div class="text-muted fs-7">Course Code: @courseCodes[i].Trim()</div>
                                        }
                                    </div>
                                    // Add a divider line between courses, except after the last one
                                    // NEW:
                                    @if (i < courseNames.Count - 1)
                                    {
                                        <hr class="my-2 text-muted opacity-25">
                                    }
                                }
                            }
                            else
                            {
                                <div class="text-muted fst-italic">No courses currently enrolled.</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ACCOUNT STATUS MANAGEMENT BOX -->
                <div class="card shadow-sm border-0 rounded-4 p-4">
                    <div class="card-body">
                        <h5 class="fw-bold text-dark mb-3 d-flex align-items-center">
                            <span class="me-2">🛡️</span> Account Status Management
                        </h5>
                        <!-- FIX: Removed the max-height and overflow from here -->
                        <div class="p-3 bg-light rounded-3">
                            <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.StudentDetailsView.Id" class="d-flex align-items-center gap-3">
                                <select name="newStatus" class="form-select bg-white shadow-none" style="max-width: 250px;" required>
                                    <option value="">-- Select Status --</option>
                                    @if (Model.StatusesList != null)
                                    {
                                        foreach (var statusName in Model.StatusesList)
                                        {
                                            <option value="@statusName" selected="@(Model.StudentDetailsView.Description == statusName)">
                                                @statusName
                                            </option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary px-4 shadow-sm">Update Status</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>