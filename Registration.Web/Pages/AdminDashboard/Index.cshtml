@page
@model Registration.Web.Pages.AdminDashboard.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .transition-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .glass-stat {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 .25rem .5rem rgba(0,0,0,.1) !important;
        }
</style>

<div class="container-fluid px-4 mt-2 mb-5" style="max-width: 1400px;">

    <!-- Premium Gradient Hero Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="p-5 rounded-4 shadow-sm border-0 text-white position-relative overflow-hidden hover-lift" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <!-- Background decorative shape -->
                <div class="position-absolute opacity-25" style="top: -50px; right: -50px; width: 300px; height: 300px; background: radial-gradient(circle, #ffffff 0%, transparent 70%); border-radius: 50%;"></div>
                <i class="bi bi-shield-check position-absolute opacity-10" style="font-size: 15rem; right: 20px; top: -50px;"></i>

                <div class="row align-items-center position-relative z-1">
                    <div class="col-xl-7 col-lg-6 mb-4 mb-lg-0">
                        <h1 class="display-5 fw-bolder mb-3" style="letter-spacing: -1px;">System Administration</h1>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <p class="fs-4 mb-0 text-white-50">Welcome back, <span class="text-white fw-semibold">@Model.AdminProfile?.Name</span>!</p>
                            <span class="badge bg-white text-primary rounded-pill px-3 py-2 fs-6 shadow-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-key-fill"></i> @Model.AdminProfile?.Role
                            </span>
                        </div>
                    </div>

                    <!-- Quick Stats on the right -->
                    <div class="col-xl-5 col-lg-6">
                        <div class="d-flex gap-3 justify-content-lg-end text-center">
                            <div class="glass-stat rounded-4 p-3 flex-fill shadow-sm transition-card">
                                <h2 class="fw-bolder mb-0 display-6">1,245</h2>
                                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Students</small>
                            </div>
                            <div class="glass-stat rounded-4 p-3 flex-fill shadow-sm transition-card">
                                <h2 class="fw-bolder mb-0 display-6">84</h2>
                                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Instructors</small>
                            </div>
                            <div class="glass-stat rounded-4 p-3 flex-fill shadow-sm transition-card">
                                <h2 class="fw-bolder mb-0 display-6">45</h2>
                                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Courses</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Grid -->
    <div class="row g-4">
        <!-- Manage Admins Card -->
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4 transition-card">
                <div class="card-body d-flex flex-column justify-content-between p-4 p-xl-5">
                    <div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center mb-4" style="width: 56px; height: 56px;">
                            <i class="bi bi-shield-lock-fill fs-3"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Manage Admins</h4>
                        <p class="card-text text-muted mb-0">Add, edit, or update administrator profiles and system permissions.</p>
                    </div>
                    <a href="/Admins" class="btn btn-outline-primary mt-4 rounded-pill fw-semibold py-2.5 hover-lift w-100">View Admins</a>
                </div>
            </div>
        </div>

        <!-- Instructors Card -->
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4 transition-card">
                <div class="card-body d-flex flex-column justify-content-between p-4 p-xl-5">
                    <div>
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex justify-content-center align-items-center mb-4" style="width: 56px; height: 56px;">
                            <i class="bi bi-person-video3 fs-3"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Instructors</h4>
                        <p class="card-text text-muted mb-0">Monitor faculty records, departments, and course assignments.</p>
                    </div>
                    <a asp-page="/Instructors/Index" class="btn btn-outline-success mt-4 rounded-pill fw-semibold py-2.5 hover-lift w-100">View Instructors</a>
                </div>
            </div>
        </div>

        <!-- Students Card -->
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4 transition-card">
                <div class="card-body d-flex flex-column justify-content-between p-4 p-xl-5">
                    <div>
                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex justify-content-center align-items-center mb-4" style="width: 56px; height: 56px;">
                            <i class="bi bi-mortarboard-fill fs-3"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Students</h4>
                        <p class="card-text text-muted mb-0">Review student admissions, academic standing, and enrollments.</p>
                    </div>
                    <a asp-page="/Students/Index" class="btn btn-outline-info mt-4 rounded-pill fw-semibold py-2.5 hover-lift w-100">View Students</a>
                </div>
            </div>
        </div>

        <!-- Courses Card -->
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4 transition-card">
                <div class="card-body d-flex flex-column justify-content-between p-4 p-xl-5">
                    <div>
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex justify-content-center align-items-center mb-4" style="width: 56px; height: 56px;">
                            <i class="bi bi-journal-bookmark-fill fs-3"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Courses</h4>
                        <p class="card-text text-muted mb-0">Manage curriculum catalogs, course descriptions, and credits.</p>
                    </div>
                    <a asp-page="/Courses/Index" class="btn btn-outline-warning mt-4 rounded-pill fw-semibold py-2.5 hover-lift w-100">View Courses</a>
                </div>
            </div>
        </div>

        <!-- Departments Card -->
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4 transition-card">
                <div class="card-body d-flex flex-column justify-content-between p-4 p-xl-5">
                    <div>
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex justify-content-center align-items-center mb-4" style="width: 56px; height: 56px;">
                            <i class="bi bi-buildings-fill fs-3"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Departments</h4>
                        <p class="card-text text-muted mb-0">Oversee academic departments and faculty divisions.</p>
                    </div>
                    <a href="/Departments" class="btn btn-outline-danger mt-4 rounded-pill fw-semibold py-2.5 hover-lift w-100">View Departments</a>
                </div>
            </div>
        </div>

        <!-- Semesters Card -->
        <div class="col-xl-4 col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0 rounded-4 transition-card">
                <div class="card-body d-flex flex-column justify-content-between p-4 p-xl-5">
                    <div>
                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex justify-content-center align-items-center mb-4" style="width: 56px; height: 56px;">
                            <i class="bi bi-calendar3 fs-3"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Semesters</h4>
                        <p class="card-text text-muted mb-0">Configure academic terms, registration periods, and active cycles.</p>
                    </div>
                    <a asp-page="/Semesters/Index" class="btn btn-outline-secondary mt-4 rounded-pill fw-semibold py-2.5 hover-lift w-100">View Semesters</a>
                </div>
            </div>
        </div>
    </div>
</div>