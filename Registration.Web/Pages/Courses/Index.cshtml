@page
@model Registration.Web.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Curriculum Courses";
}

<div class="container-fluid px-4 py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-xl-6 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <span class="fs-4">📚</span>
                </div>
                <div>
                    <h2 class="fw-bold text-dark mb-1 tracking-tight">Curriculum Courses</h2>
                    <p class="text-muted mb-0 fs-6">Manage curriculum catalogs, course descriptions, and credits.</p>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-md-7">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <a asp-page="/CourseSchedules/Index" class="btn btn-white bg-white text-dark border shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    🗓️ Course Schedules
                </a>
                <button type="button" class="btn btn-primary shadow px-4 py-2 rounded-pill fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#registerCourseModal">
                    <span>+</span> Add Course
                </button>
                <a asp-page="/AdminDashboard/Index" class="btn btn-light border text-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    ← Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Success / Error Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-success bg-opacity-10 text-success py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">✨</span>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <!-- Card Header Toolbar -->
        <div class="card-header bg-white border-bottom py-4 px-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-5 col-md-12">
                    <div class="input-group input-group-lg bg-light border rounded-pill overflow-hidden shadow-none">
                        <span class="input-group-text bg-transparent border-0 ps-4 text-muted">🔍</span>
                        <input type="text" id="searchInput" class="form-control border-0 bg-transparent shadow-none fs-6 ps-2" placeholder="Search by code or course name...">
                    </div>
                </div>
                <!-- Department Filter -->
                <div class="col-lg-3 col-md-4">
                    <select id="departmentFilter" class="form-select form-select-lg bg-light border rounded-pill px-4 fs-6 shadow-none">
                        <option value="">All Departments</option>
                        @if (Model.DepartmentsList != null)
                        {
                            foreach (var dept in Model.DepartmentsList)
                            {
                                <option value="@dept.Code">@dept.Code - @dept.Name</option>
                            }
                        }
                    </select>
                </div>
                <!-- Status Filter -->
                <div class="col-lg-2 col-md-4">
                    <select id="statusFilter" class="form-select form-select-lg bg-light border rounded-pill px-4 fs-6 shadow-none">
                        <option value="">All Statuses</option>
                        @if (Model.StatusesList != null)
                        {
                            foreach (var status in Model.StatusesList)
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>
                <!-- Search Button -->
                <div class="col-lg-2 col-md-4 text-md-end">
                    <button type="button" class="btn btn-primary btn-lg w-100 rounded-pill fw-semibold shadow-sm px-4" onclick="filterTable()">
                        Search
                    </button>
                </div>
            </div>
        </div>

        <!-- Table View -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="bg-light text-uppercase fs-7 text-muted fw-bold">
                        <tr>
                            <th class="py-3 ps-4"># ID</th>
                            <th class="py-3">Code</th>
                            <th class="py-3">Course Name</th>
                            <th class="py-3">Department</th>
                            <th class="py-3 text-center">Credits</th>
                            <th class="py-3 text-center">Difficulty</th>
                            <th class="py-3 text-center">Students</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CoursesList != null && Model.CoursesList.Any())
                        {
                            foreach (var course in Model.CoursesList)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@course.Id</td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded">@course.Code</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@course.Name</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            @(course.DepartmentCode ?? "N/A")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-semibold text-secondary">@course.Credit_Hours CH</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-medium text-dark">@(course.Difficulty > 0 ? course.Difficulty.ToString() : "-")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill fw-bold">
                                            👥 @course.TotalStudents
                                        </span>
                                    </td>

                                    @{
                                        var badgeTheme = course.Description switch
                                        {
                                            "Available" => "bg-success text-success border-success",
                                            "Under Revision" => "bg-warning text-warning border-warning",
                                            "Closed" => "bg-secondary text-secondary border-secondary",
                                            "Cancelled" => "bg-danger text-danger border-danger",
                                            "Archived" => "bg-dark text-dark border-dark",
                                            _ => "bg-primary text-primary border-primary"
                                        };
                                    }
                                    <td>
                                        <span class="badge @badgeTheme bg-opacity-10 border border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            ● @course.Description
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border text-primary fw-semibold rounded-pill px-4 py-2 shadow-sm hover-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCourseModal"
                                                data-id="@course.Id"
                                                data-code="@course.Code"
                                                data-name="@course.Name"
                                                data-credits="@course.Credit_Hours"
                                                data-difficulty="@course.Difficulty"
                                                data-deptcode="@course.DepartmentCode"
                                                data-statusid="@course.Status_Id">
                                            ✏️ Edit Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <span class="fs-1 d-block mb-2">📂</span>
                                        <p class="mb-0 fw-semibold">No course records found in the database directory.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add New Course Modal -->
<div class="modal fade" id="registerCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="CreateCourse">
                <div class="modal-header bg-light px-4 py-3 border-0">
                    <h5 class="modal-title fw-bold text-dark">Add New Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Course Code</label>
                            <input type="text" name="NewCourse.Code" class="form-control bg-light border-0 py-2.5 rounded-3" required placeholder="e.g. CS101">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Credit Hours (CH)</label>
                            <input type="number" name="NewCourse.Credit_Hours" class="form-control bg-light border-0 py-2.5 rounded-3" min="1" max="10" value="3" required>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Course Name</label>
                            <input type="text" name="NewCourse.Name" class="form-control bg-light border-0 py-2.5 rounded-3" required placeholder="e.g. Data Structures">
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Assign to Department</label>
                            <select name="SelectedDepartmentId" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled selected>-- Select Department --</option>
                                @if (Model.DepartmentsList != null)
                                {
                                    foreach (var dept in Model.DepartmentsList)
                                    {
                                        <option value="@dept.Id">@dept.Code - @dept.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Difficulty Level</label>
                            <input type="number" name="NewCourse.Difficulty" class="form-control bg-light border-0 py-2.5 rounded-3" min="1" max="5">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Status</label>
                            <select name="NewCourse.Status_Id" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled selected>-- Select Status --</option>
                                @if (Model.StatusesList != null && Model.StatusesList.Any())
                                {
                                    int idCounter = 1;
                                    foreach (var status in Model.StatusesList)
                                    {
                                        <option value="@idCounter">@status</option>
                                        idCounter++;
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-light px-4 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold">Save Course</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Course Modal -->
<div class="modal fade" id="editCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form method="post" asp-page-handler="UpdateCourse">
                <input type="hidden" id="editCourseId" name="NewCourse.Id" />
                <div class="modal-header bg-light px-4 py-3 border-0">
                    <h5 class="modal-title fw-bold text-dark">Edit Course Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Course Code</label>
                            <input type="text" id="editCode" name="NewCourse.Code" class="form-control bg-light border-0 py-2.5 rounded-3" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Credit Hours (CH)</label>
                            <input type="number" id="editCredits" name="NewCourse.Credit_Hours" class="form-control bg-light border-0 py-2.5 rounded-3" min="1" max="10" required>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Course Name</label>
                            <input type="text" id="editName" name="NewCourse.Name" class="form-control bg-light border-0 py-2.5 rounded-3" required>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Assign to Department</label>
                            <select id="editDepartmentId" name="SelectedDepartmentId" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled>-- Update Department --</option>
                                @if (Model.DepartmentsList != null)
                                {
                                    foreach (var dept in Model.DepartmentsList)
                                    {
                                        <option value="@dept.Id">@dept.Code - @dept.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Difficulty Level</label>
                            <input type="number" id="editDifficulty" name="NewCourse.Difficulty" class="form-control bg-light border-0 py-2.5 rounded-3" min="1" max="5">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Status</label>
                            <select id="editStatusId" name="NewCourse.Status_Id" class="form-select bg-light border-0 py-2.5 rounded-3" required>
                                <option value="" disabled>-- Select Status --</option>
                                @if (Model.StatusesList != null && Model.StatusesList.Any())
                                {
                                    int idCounter = 1;
                                    foreach (var status in Model.StatusesList)
                                    {
                                        <option value="@idCounter">@status</option>
                                        idCounter++;
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 border-0">
                    <button type="button" class="btn btn-light px-4 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let statusFilter = document.getElementById("statusFilter").value.toLowerCase();
            let deptFilter = document.getElementById("departmentFilter").value.toLowerCase();
            let rows = document.querySelectorAll("tbody tr");

            rows.forEach(row => {
                if (row.cells.length < 8) return;

                let code = row.cells[1].textContent.toLowerCase();
                let name = row.cells[2].textContent.toLowerCase();
                let dept = row.cells[3].textContent.toLowerCase();
                let status = row.cells[7].textContent.toLowerCase();

                let matchesSearch = name.includes(input) || code.includes(input);
                let matchesStatus = statusFilter === "" || status.includes(statusFilter);
                let matchesDept = deptFilter === "" || dept.includes(deptFilter);

                row.style.display = (matchesSearch && matchesStatus && matchesDept) ? "" : "none";
            });
        }

        const editModal = document.getElementById('editCourseModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            let button = event.relatedTarget;
            document.getElementById('editCourseId').value = button.getAttribute('data-id');
            document.getElementById('editCode').value = button.getAttribute('data-code');
            document.getElementById('editName').value = button.getAttribute('data-name');
            document.getElementById('editCredits').value = button.getAttribute('data-credits');
            document.getElementById('editDifficulty').value = button.getAttribute('data-difficulty');
            document.getElementById('editStatusId').value = button.getAttribute('data-statusid');

            // Select department dropdown by matching code
            let deptCode = button.getAttribute('data-deptcode');
            let deptSelect = document.getElementById('editDepartmentId');
            deptSelect.value = "";
            if (deptCode && deptCode !== "N/A") {
                for (let option of deptSelect.options) {
                    if (option.text.trim().toUpperCase().startsWith(deptCode.trim().toUpperCase())) {
                        deptSelect.value = option.value;
                        break;
                    }
                }
            }
        });
    </script>
}