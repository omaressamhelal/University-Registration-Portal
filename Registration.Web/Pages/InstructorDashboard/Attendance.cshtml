@page "{courseId:int}/{scheduleId:int}"
@model Registration.Web.Pages.InstructorDashboard.AttendanceModel
@{
    ViewData["Title"] = "Manage Attendance";
}

<div class="container-fluid px-4 py-4" style="min-height: 90vh;">
    <!-- Modern Header Section with Subject, Type, Date, and Content Badges -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-xl-8 col-md-7">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                    <span class="fs-4">✅</span>
                </div>
                <div>
                    <h2 class="fw-bold mb-2 tracking-tight">Attendance Roll Call</h2>

                    <!-- Dynamic Metadata Badges -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                            📚 @Model.CourseCode — @Model.CourseName
                        </span>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                            🏷️ @Model.ScheduleType
                        </span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                            📅 @Model.AttendanceDate.ToString("dd/MM/yyyy")
                        </span>

                        <!-- 🌟 Topic / Content Covered Badge (Fixed to use AttendanceList) -->
                        @if (Model.AttendanceList != null && Model.AttendanceList.Any() && !string.IsNullOrEmpty(Model.AttendanceList.First().Content_Covered))
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                📖 @Model.AttendanceList.First().Content_Covered
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-5">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <a asp-page="./CourseRoster" asp-route-courseId="@Model.CourseId" class="btn btn-light border text-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    ← Back to Roster
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert">
            <span>🎉 @Model.StatusMessage</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Attendance Form Card -->
    <form method="post" asp-page-handler="SaveAttendance">
        <input type="hidden" name="CourseId" value="@Model.CourseId" />
        <input type="hidden" name="ScheduleId" value="@Model.ScheduleId" />

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-transparent border-bottom py-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary">Student Attendance Sheet</h5>
                <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm fw-semibold">
                    💾 Save Changes
                </button>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="text-uppercase fs-7 text-muted fw-bold">
                            <tr>
                                <th class="py-3 ps-4">Student ID</th>
                                <th class="py-3">Student Name</th>
                                <th class="py-3 text-center">Attendance Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AttendanceList != null && Model.AttendanceList.Any())
                            {
                                foreach (var record in Model.AttendanceList)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-secondary">@record.Student_Id</td>
                                        <td>
                                            <span class="fw-bold text-dark">@record.StudentName</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="form-check form-switch d-inline-block">
                                                <!-- Fixed: removed role="switch" to resolve HTML validation warnings -->
                                                <input class="form-check-input fs-5 attendance-toggle" type="checkbox"
                                                       name="PresentStudentIds" value="@record.Student_Id"
                                                       @(record.IsPresent ? "checked" : "")
                                                       onchange="updateLabel(this)" />
                                                <label class="form-check-label fw-semibold ms-2 status-label @(record.IsPresent ? "text-success" : "text-muted")">
                                                    @(record.IsPresent ? "Present" : "Absent")
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5 text-muted">
                                        <div class="py-4">
                                            <span class="fs-1 d-block mb-2">📭</span>
                                            <p class="mb-0 fw-semibold">No students found in this course roster.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Dynamically update label text and color when a switch is toggled
        function updateLabel(checkbox) {
            var label = checkbox.nextElementSibling;
            if (checkbox.checked) {
                label.textContent = "Present";
                label.classList.remove("text-muted");
                label.classList.add("text-success");
            } else {
                label.textContent = "Absent";
                label.classList.remove("text-success");
                label.classList.add("text-muted");
            }
        }
    </script>
}