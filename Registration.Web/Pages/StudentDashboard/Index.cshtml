@page
@model Registration.Web.Pages.StudentDashboard.IndexModel
@{
    ViewData["Title"] = "My Dashboard";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-4 px-md-5">
    @if (Model.StudentProfile != null)
    {
        <!-- Modern Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2">
            <div>
                <h2 class="display-6 fw-bolder text-dark mb-1" style="letter-spacing: -1px;">Welcome, <span class="text-primary">@Model.StudentProfile.StudentName</span> 👋</h2>
                <p class="text-muted fs-5 mb-0">Here is your current academic overview</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- LEFT COLUMN: Academic Profile & Enrolled Courses -->
            <div class="col-lg-8 d-flex flex-column gap-4">

                <!-- Academic Profile Card (Upgraded Layered Look) -->
                <div class="card border-0 shadow-sm rounded-4 hover-lift-card">
                    <div class="card-body p-4 p-xl-5">
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-person-badge fs-4"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-0">Academic Profile</h4>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="bg-light rounded-4 p-3 h-100 border border-light-subtle">
                                    <label class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">Email Address</label>
                                    <p class="mb-0 fs-6 fw-semibold text-dark">@Model.StudentProfile.Email</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light rounded-4 p-3 h-100 border border-light-subtle">
                                    <label class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">Department</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <p class="mb-0 fs-6 fw-semibold text-dark text-truncate">@Model.StudentProfile.DepartmentName</p>
                                        <span class="badge bg-white text-primary border border-primary-subtle shadow-sm px-2 py-1">@Model.StudentProfile.DepartmentCode</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light rounded-4 p-3 h-100 border border-light-subtle">
                                    <label class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">National ID</label>
                                    <p class="mb-0 fs-6 fw-semibold text-dark">@Model.StudentProfile.National_Id</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light rounded-4 p-3 h-100 border border-light-subtle">
                                    <label class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">Academic Year</label>
                                    <p class="mb-0 fs-6 fw-semibold text-dark">Year @Model.StudentProfile.Year</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Enrolled Courses Card -->
                <div class="card border-0 shadow-sm rounded-4 flex-grow-1 hover-lift-card">
                    <div class="card-body p-4 p-xl-5">

                        <!-- Header & Actions -->
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 48px; height: 48px;">
                                    <i class="bi bi-book fs-4"></i>
                                </div>
                                <div>
                                    <h4 class="fw-bold text-dark mb-0">Enrolled Courses</h4>
                                    <span class="text-muted small fw-medium">@Model.CurrentSemesterName Semester</span>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="badge bg-light text-dark border px-3 py-2 fw-semibold fs-6 shadow-sm">
                                    📚 @Model.CurrentSemesterCredits Credits
                                </span>

                                @if (Model.IsRegistrationOpen)
                                {
                                    <a asp-page="./RegisterCourses" asp-route-studentId="@Model.StudentProfile.Id" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-sm hover-lift d-inline-flex align-items-center gap-2">
                                        <i class="bi bi-stars"></i> Register
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill fw-semibold shadow-sm d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-lock-fill"></i> Registration Closed
                                    </span>
                                }

                                <a asp-page="./Schedule" asp-route-studentId="@Model.StudentProfile.Id" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold shadow-sm hover-lift">
                                    <i class="bi bi-calendar3 me-1"></i> Schedule
                                </a>
                            </div>
                        </div>

                        <!-- Courses List -->
                        <div class="bg-light bg-opacity-50 rounded-4 p-4 border border-light-subtle">
                            @if (Model.RecentSemesterCourses != null && Model.RecentSemesterCourses.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var course in Model.RecentSemesterCourses)
                                    {
                                        var status = string.IsNullOrEmpty(course.StatusDescription) ? "Unknown" : course.StatusDescription.Trim();
                                        string badgeClass = "bg-white text-dark border-secondary-subtle";
                                        string dotClass = "text-primary";

                                        switch (status.ToLower())
                                        {
                                            case "pending":
                                                dotClass = "text-warning";
                                                break;
                                            case "dropped":
                                                badgeClass = "bg-white text-muted border-danger-subtle opacity-75";
                                                dotClass = "text-danger";
                                                break;
                                            case "completed":
                                                dotClass = "text-success";
                                                break;
                                        }

                                        <div class="d-inline-flex align-items-center border rounded-pill px-4 py-2.5 shadow-sm transition-hover hover-scale @badgeClass">
                                            <i class="bi bi-circle-fill @dotClass me-2" style="font-size: 0.5rem;"></i>
                                            <span class="fs-6 fw-semibold me-1">@course.CourseName</span>

                                            @if (status.ToLower() != "active" && status.ToLower() != "enrolled" && status.ToLower() != "unknown")
                                            {
                                                <small class="fw-bold opacity-50 ms-1" style="font-size: 0.7rem; text-transform: uppercase;">(@status)</small>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    <p class="mb-0 fs-5 fw-medium">No active courses found for the current semester.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN: GPA, Status, Degree Progress & Academic Records -->
            <div class="col-lg-4 d-flex flex-column gap-4">

                <!-- GPA Card (Upgraded Gradient) -->
                <div class="card border-0 shadow-sm rounded-4 text-white hover-lift-card" style="background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);">
                    <div class="card-body p-4 p-xl-5 d-flex flex-column justify-content-center align-items-center text-center position-relative overflow-hidden">
                        <i class="bi bi-award position-absolute opacity-10" style="font-size: 8rem; right: -20px; bottom: -20px;"></i>
                        <h6 class="text-uppercase fw-bold mb-2 text-white-50" style="letter-spacing: 1.5px;">Cumulative GPA</h6>
                        <h1 class="display-2 fw-bolder mb-0 position-relative" style="letter-spacing: -2px;">@Model.TrueCumulativeGpa</h1>
                    </div>
                </div>

                <!-- Status Card -->
                <div class="card border-0 shadow-sm rounded-4 hover-lift-card">
                    <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center text-center">
                        <h6 class="text-muted text-uppercase fw-bold mb-3" style="letter-spacing: 1px;">Current Status</h6>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-5 py-2 fs-5 rounded-pill shadow-sm">
                            @Model.StudentProfile.Description
                        </span>
                    </div>
                </div>

                <!-- Degree Progress Bar Widget -->
                <div class="card border-0 shadow-sm rounded-4 hover-lift-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1px;">Degree Progress</span>
                            <span class="fw-bold text-primary bg-primary bg-opacity-10 px-2 py-1 rounded-2 small">@Model.TotalCreditsEarned / @Model.GraduationRequiredCredits</span>
                        </div>
                        <div class="progress rounded-pill bg-light mb-3 shadow-inner" style="height: 12px;">
                            <div class="progress-bar bg-primary rounded-pill progress-bar-striped progress-bar-animated" role="progressbar" style="width: @Model.GraduationProgressPercentage%;" aria-valuenow="@Model.GraduationProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center text-muted fw-medium" style="font-size: 0.8rem;">
                            <span>@Model.GraduationProgressPercentage% Completed</span>
                            <span>Bachelor's Track</span>
                        </div>
                    </div>
                </div>

                <!-- Dual/Triple Action Card (Semester Grades, Official Transcript & Degree Plan) -->
                <div class="card border-0 shadow-sm rounded-4 flex-grow-1 hover-lift-card">
                    <div class="card-body p-4 p-xl-5 text-center d-flex flex-column justify-content-center align-items-center">
                        <h5 class="fw-bold text-dark mb-1">Academic Records & Progress</h5>
                        <p class="text-muted small mb-4">View your semester grades, complete official academic transcript, or map out your future degree requirements.</p>

                        <div class="d-flex flex-column gap-3 w-100">
                            <!-- View Semester Grades Button -->
                            <a asp-page="./Grades" asp-route-studentId="@Model.StudentProfile.Id" class="btn btn-success rounded-pill px-4 py-2.5 w-100 fw-bold shadow-sm hover-lift d-flex justify-content-center align-items-center gap-2" style="background-color: #198754;">
                                <i class="bi bi-bar-chart-line fs-5"></i> View Semester Grades
                            </a>
                            <!-- View Official Transcript Button -->
                            <a asp-page="./Transcript" asp-route-studentId="@Model.StudentProfile.Id" class="btn text-white rounded-pill px-4 py-2.5 w-100 fw-bold shadow-sm hover-lift d-flex justify-content-center align-items-center gap-2" style="background-color: #6f42c1;">
                                <i class="bi bi-mortarboard fs-5"></i> View Official Transcript
                            </a>
                            <!-- 🌟 New View Degree Plan Button -->
                            <a asp-page="./DegreePlan" asp-route-studentId="@Model.StudentProfile.Id" class="btn text-white rounded-pill px-4 py-2.5 w-100 fw-bold shadow-sm hover-lift d-flex justify-content-center align-items-center gap-2" style="background-color: #0dcaf0;">
                                <i class="bi bi-map fs-5"></i> View Degree Plan
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
    else
    {
        <!-- Empty / Error State -->
        <div class="d-flex justify-content-center align-items-center" style="min-height: 50vh;">
            <div class="alert alert-danger shadow-sm rounded-4 px-4 py-3 border-0 border-start border-5 border-danger" role="alert">
                <h5 class="alert-heading fw-bold mb-1">Profile Not Found</h5>
                <p class="mb-0">We couldn't load your profile details right now. Please try refreshing the page.</p>
            </div>
        </div>
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .hover-lift-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-lift-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08) !important;
        }

    .hover-scale {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

        .hover-scale:hover {
            transform: scale(1.03);
            background-color: #f8f9fa !important;
        }

    .shadow-inner {
        box-shadow: inset 0 1px 2px rgba(0,0,0,.075);
    }
</style>