@page "{courseId:int}"
@model Registration.Web.Pages.InstructorDashboard.CourseRosterModel
@{
    ViewData["Title"] = "Course Roster";
}

<div class="container-fluid px-4 py-4" style="min-height: 90vh; background-color: #f8f9fa;">

    <!-- ERROR BANNER -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-4 shadow-sm border-0 bg-danger bg-opacity-10 text-danger py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold"><strong>Action Failed:</strong> @TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Modern Header Section -->
    <div class="row align-items-center mb-4 g-3 bg-white p-4 rounded-4 shadow-sm border">
        <div class="col-xl-5 col-md-5">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px; min-width: 56px;">
                    <span class="fs-4">👥</span>
                </div>
                <div>
                    <h2 class="fw-bold mb-0 text-dark tracking-tight">
                        @(Model.EnrolledStudents.FirstOrDefault()?.CourseName ?? Model.CourseDetails.Name ?? "Course Roster")
                    </h2>
                    <p class="text-muted mb-0 fs-6">
                        Class Management & Roster
                    </p>
                </div>
            </div>
        </div>
        <div class="col-xl-7 col-md-7 text-md-end">
            <div class="d-flex align-items-center justify-content-md-end gap-2 flex-wrap">
                <!-- ATTENDANCE BUTTON -->
                <button type="button" class="btn btn-success shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift text-white d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#attendanceModal">
                    <span>✅</span> Take Attendance
                </button>

                <!-- ENTER GRADES BUTTON -->
                <a asp-page="./Grades" asp-route-courseId="@Model.CourseId" class="btn btn-primary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift d-inline-flex align-items-center gap-2 text-decoration-none">
                    <span>📝</span> Enter Grades
                </a>

                <!-- 🌟 BACK TO DASHBOARD BUTTON POSITIONED ON THE FAR RIGHT -->
                <a asp-page="./Index" class="btn btn-light border text-secondary shadow-sm px-4 py-2 rounded-pill fw-semibold hover-lift">
                    ← Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Main Card Container -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom py-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                <span>📚</span> Enrolled Students
            </h5>

            <div class="d-flex align-items-center gap-3">
                <!-- SEARCH BAR FORM -->
                <form method="get" class="d-flex align-items-center gap-2">
                    <div class="input-group bg-light border rounded-pill overflow-hidden shadow-none" style="width: 280px;">
                        <span class="input-group-text bg-transparent border-0 ps-3 text-muted">🔍</span>
                        <input type="text" class="form-control border-0 bg-transparent shadow-none fs-6 ps-1" name="SearchQuery" value="@Model.SearchQuery" placeholder="Search student name..." />
                        @if (!string.IsNullOrEmpty(Model.SearchQuery))
                        {
                            <a asp-page="./CourseRoster" asp-route-courseId="@Model.CourseId" class="btn btn-light border-0 px-3 text-muted d-flex align-items-center" title="Clear filter">✕</a>
                        }
                        else
                        {
                            <button class="btn btn-primary px-3 rounded-end-pill" type="submit">Search</button>
                        }
                    </div>
                </form>

                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                    @Model.TotalStudents Students
                </span>
            </div>
        </div>

        <!-- Table View -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-uppercase fs-7 text-muted fw-bold bg-light">
                        <tr>
                            <th class="py-3 ps-4">Enrollment ID</th>
                            <th class="py-3">Student Name</th>
                            <th class="py-3">Course Name</th>
                            <th class="py-3 text-center pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EnrolledStudents != null && Model.EnrolledStudents.Any())
                        {
                            foreach (var enrollment in Model.EnrolledStudents)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@enrollment.Id</td>
                                    <td>
                                        <span class="fw-bold text-dark d-inline-flex align-items-center gap-1">
                                            @enrollment.StudentName
                                        </span>
                                    </td>
                                    <td class="text-muted">@enrollment.CourseName</td>

                                    @{
                                        var badgeTheme = enrollment.StatusName switch
                                        {
                                            "Enrolled" => "bg-success text-success border-success",
                                            "Pending" => "bg-warning text-warning border-warning",
                                            "Dropped" => "bg-danger text-danger border-danger",
                                            _ => "bg-secondary text-secondary border-secondary"
                                        };
                                    }
                                    <td class="text-center pe-4">
                                        <span class="badge @badgeTheme bg-opacity-10 border border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                            ● @enrollment.StatusName
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <span class="fs-1 d-block mb-2">📭</span>
                                        <p class="mb-0 fw-semibold">No students found matching your search criteria.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Selection & Creation Modal -->
<div class="modal fade" id="attendanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header px-4 py-3 border-0 bg-light">
                <h5 class="modal-title fw-bold text-primary">Attendance Management</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">

                <!-- Tabs Navigation -->
                <ul class="nav nav-tabs nav-justified bg-light px-3 pt-2 border-bottom-0" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold text-dark pb-3 border-0 border-bottom border-primary border-3" id="new-tab" data-bs-toggle="tab" data-bs-target="#new-session" type="button" role="tab">
                            <span class="fs-6 d-block mb-1">✨</span> New Session
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold text-secondary pb-3 border-0" id="past-tab" data-bs-toggle="tab" data-bs-target="#past-session" type="button" role="tab">
                            <span class="fs-6 d-block mb-1">📅</span> Past Sessions
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-4">

                    <!-- TAB 1: CREATE NEW LECTURE EVENT -->
                    <div class="tab-pane fade show active" id="new-session" role="tabpanel">
                        <p class="text-muted small mb-4">Create a new lecture event to start marking attendance for today's class.</p>

                        <form method="post" asp-page-handler="CreateLecture" asp-route-courseId="@Model.CourseId">
                            <input type="hidden" name="CourseId" value="@Model.CourseId" />

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small text-uppercase fw-bold">Session Type</label>
                                    <select class="form-select bg-light" name="SelectedScheduleType" required>
                                        <option value="Lecture" selected>Lecture</option>
                                        <option value="Section">Section</option>
                                        <option value="Lab">Lab</option>
                                    </select>
                                </div>

                                <div class="col-md-6 mt-3 mt-md-0">
                                    <label class="form-label text-muted small text-uppercase fw-bold">Date of Event</label>
                                    <input type="date" class="form-control bg-light" name="AttendanceDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-muted small text-uppercase fw-bold">Topic / Content Covered</label>
                                <input type="text" class="form-control bg-light" name="Content_Covered" placeholder="e.g., Intro to Signal Processing" required />
                            </div>

                            <div class="text-end">
                                <button type="button" class="btn border px-4 rounded-pill fw-semibold me-2" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm fw-semibold">Create & Start Roll Call</button>
                            </div>
                        </form>
                    </div>

                    <!-- TAB 2: SELECT PAST LECTURE EVENT -->
                    <div class="tab-pane fade" id="past-session" role="tabpanel">
                        <p class="text-muted small mb-4">Select an existing lecture event to view or modify previously recorded attendance.</p>

                        <form onsubmit="redirectToAttendance(event)">
                            <input type="hidden" id="currentCourseId" value="@Model.CourseId" />

                            <div class="mb-4">
                                <label class="form-label text-muted small text-uppercase fw-bold">Select Past Date</label>
                                <select class="form-select bg-light" id="selectedScheduleId" required>
                                    <option value="" disabled selected>-- Select a past lecture --</option>

                                    @if (Model.PastLectures != null && Model.PastLectures.Any())
                                    {
                                        foreach (var lecture in Model.PastLectures)
                                        {
                                            var displayType = !string.IsNullOrWhiteSpace(lecture.ScheduleType) ? lecture.ScheduleType : "Session";

                                            <option value="@lecture.ScheduleId">
                                                @lecture.AttendanceDate.ToString("dd/MM/yyyy") — @displayType — (@lecture.StudentsAttended students recorded)
                                            </option>
                                        }
                                    }
                                    else
                                    {
                                        <option disabled>No past sessions found.</option>
                                    }
                                </select>
                            </div>

                            <div class="text-end">
                                <button type="button" class="btn border px-4 rounded-pill fw-semibold me-2" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-semibold">View Attendance</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift:hover {
        transform: translateY(-2px);
        transition: all 0.2s ease-in-out;
    }

    .shadow-xs {
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
</style>

@section Scripts {
    <script>
        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                alert('@Html.Raw(TempData["ErrorMessage"].ToString().Replace("'", "\\'"))');
                </text>
        }

        function redirectToAttendance(event) {
            event.preventDefault();
            var courseId = document.getElementById('currentCourseId').value;
            var scheduleId = document.getElementById('selectedScheduleId').value;

            if (scheduleId) {
                window.location.href = `/InstructorDashboard/Attendance/${courseId}/${scheduleId}`;
            }
        }
    </script>
}