@page
@model Registration.Web.Pages.StudentDashboard.ScheduleModel
@{
    ViewData["Title"] = "My Schedule";
    // Group the classes by Day so we can display them under day headers
    var groupedSchedule = Model.WeeklySchedule.GroupBy(s => s.Day).ToList();
    int totalSessions = Model.WeeklySchedule?.Count ?? 0;
}

<!-- Bootstrap Icons stylesheet -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid py-4 px-md-5">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h2 class="display-6 fw-bold text-dark mb-0">Weekly Schedule</h2>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fs-6 fw-semibold shadow-xs">
                    📅 Academic Timetable
                </span>
            </div>
            <p class="text-muted fs-6 mb-0">Your upcoming classes, lectures, and sections for the semester.</p>
        </div>
        <div>
            <a asp-page="/StudentDashboard/Index" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary border shadow-sm rounded-pill px-4 py-2 fw-semibold hover-lift">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Quick Summary Metrics Bar -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 d-flex flex-row align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-calendar-check fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block fw-medium">Total Weekly Sessions</span>
                    <h4 class="fw-bold text-dark mb-0">@totalSessions Classes</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 d-flex flex-row align-items-center gap-3">
                <div class="bg-success bg-opacity-10 text-success rounded-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-journal-bookmark fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block fw-medium">Active Days</span>
                    <h4 class="fw-bold text-dark mb-0">@groupedSchedule.Count() Days</h4>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 bg-danger bg-opacity-10 text-danger py-3 px-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-3 fs-4">⚠️</span>
                <div class="fw-semibold">@Model.ErrorMessage</div>
            </div>
        </div>
    }

    @if (groupedSchedule.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var dayGroup in groupedSchedule)
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <!-- Day Header Card Bar -->
                    <div class="card-header bg-light border-bottom py-3 px-4 d-flex align-items-center gap-3">
                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow-xs" style="width: 36px; height: 36px;">
                            <i class="bi bi-calendar-day fs-6"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-0">@dayGroup.Key</h5>
                        <span class="badge bg-white text-secondary border ms-auto px-3 py-1.5 rounded-pill fw-semibold shadow-xs">
                            @dayGroup.Count() @(dayGroup.Count() == 1 ? "Session" : "Sessions")
                        </span>
                    </div>

                    <!-- Classes List for the Day -->
                    <div class="card-body p-4">
                        <div class="row g-3">
                            @foreach (var item in dayGroup)
                            {
                                var isLecture = string.Equals(item.Type, "Lecture", StringComparison.OrdinalIgnoreCase);
                                var borderAccent = isLecture ? "border-start-primary" : "border-start-info";

                                <div class="col-md-6 col-xl-4">
                                    <div class="card border-0 shadow-xs rounded-3 p-3 h-100 @borderAccent transition-hover bg-light bg-opacity-25 border">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="fw-bold text-primary bg-primary bg-opacity-10 px-2.5 py-1 rounded-2 border border-primary-subtle" style="font-size: 0.8rem;">
                                                @item.CourseCode
                                            </span>
                                            @if (isLecture)
                                            {
                                                <span class="badge bg-primary text-white px-2.5 py-1 rounded-pill fw-semibold shadow-xs" style="font-size: 0.7rem;">
                                                    <i class="bi bi-book me-1"></i> Lecture
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark px-2.5 py-1 rounded-pill fw-semibold shadow-xs" style="font-size: 0.7rem;">
                                                    <i class="bi bi-people me-1"></i> @item.Type
                                                </span>
                                            }
                                        </div>

                                        <h6 class="fw-bold text-dark mb-3">@item.CourseName</h6>

                                        <div class="d-flex flex-column gap-2 text-muted small mt-auto pt-2 border-top border-light">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-clock text-primary"></i>
                                                <span class="fw-semibold text-dark">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-badge text-secondary"></i>
                                                <span class="fw-medium">@item.InstructorName</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
            <div class="card-body py-4">
                <span class="display-4 d-block mb-3">🗓️</span>
                <h5 class="fw-bold text-dark mb-1">No Schedule Available</h5>
                <p class="text-muted small mb-0">You have no classes scheduled for this semester.</p>
            </div>
        </div>
    }
</div>

<style>
    .border-start-primary {
        border-left: 4px solid var(--bs-primary) !important;
    }

    .border-start-info {
        border-left: 4px solid var(--bs-info) !important;
    }

    .hover-lift {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
        }

    .transition-hover {
        transition: all 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-3px);
            background-color: #ffffff !important;
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.06) !important;
            border-color: var(--bs-primary-border-subtle) !important;
        }
</style>